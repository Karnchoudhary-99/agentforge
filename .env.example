# Optional external LLM provider. Keep real credentials in .env or deployment secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Application
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Local PostgreSQL (compose defaults are for development only)
POSTGRES_DB=agentforge
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge_local_only
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agentforge
SPRING_DATASOURCE_USERNAME=agentforge
SPRING_DATASOURCE_PASSWORD=agentforge_local_only
